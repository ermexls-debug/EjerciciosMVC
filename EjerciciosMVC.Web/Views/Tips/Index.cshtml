@model TipViewModel

@{
    ViewData["Title"] = "Calculadora de propinas";
}

<h1>Calculadora de propinas</h1>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Index" method="post">

            <div class="mb-3">
                <label asp-for="BillAmount" class="form-label"></label>
                <input asp-for="BillAmount" class="form-control" type="number" step="1" />
                <span asp-validation-for="BillAmount" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Percentage" class="form-label"></label>
                <select asp-for="Percentage" class="form-select">
                    <option value="">-- Selecciona --</option>
                    <option value="5">5%</option>
                    <option value="10">10%</option>
                    <option value="15">15%</option>
                    <option value="20">20%</option>
                </select>
                <span asp-validation-for="Percentage" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Calculate</button>
        </form>
    </div>
</div>

@if (Model.Calculated)
{
    <div class="alert alert-success mt-4 col-md-5">
        <p>Valor de la cuenta: $@Model.BillAmount.Value.ToString("N0")</p>
        <p>Propina (@Model.Percentage%): $@Model.Tip.ToString("N0")</p>
        <p><strong>Total a pagar: $@Model.Total.ToString("N0")</strong></p>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
