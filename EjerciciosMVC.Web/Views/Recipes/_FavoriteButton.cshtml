@model Recipe

<form asp-controller="Recipes" asp-action="ToggleFavorite" asp-route-id="@Model.Id" method="post" class="d-inline">
    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
    @if (Model.IsFavorite)
    {
        <button type="submit" class="btn btn-sm btn-warning" title="Quitar de favoritas">&#9733; Favorita</button>
    }
    else
    {
        <button type="submit" class="btn btn-sm btn-outline-warning" title="Guardar como favorita">&#9734; Guardar</button>
    }
</form>
