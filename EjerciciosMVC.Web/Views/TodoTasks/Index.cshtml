@model TodoTaskListViewModel

@{
    ViewData["Title"] = "Lista de tareas";
}

<h1>Lista de tareas</h1>

<div class="row">
    <div class="col-md-7">
        <form asp-action="Create" method="post" class="mb-4">
            <div class="mb-3">
                <label asp-for="NewTitle" class="form-label"></label>
                <input asp-for="NewTitle" class="form-control" />
                <span asp-validation-for="NewTitle" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Agregar</button>
        </form>

        @if (Model.Tasks.Count == 0)
        {
            <p class="text-muted">No hay tareas. ¡Agrega la primera!</p>
        }
        else
        {
            <ul class="list-group">
                @foreach (TodoTask task in Model.Tasks)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            @if (task.IsCompleted)
                            {
                                <span class="text-decoration-line-through text-muted">@task.Title</span>
                            }
                            else
                            {
                                <span>@task.Title</span>
                            }
                            <small class="text-muted d-block">@task.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-action="ToggleComplete" asp-route-id="@task.Id" method="post">
                                @if (task.IsCompleted)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Desmarcar</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-success">Completar</button>
                                }
                            </form>
                            <form asp-action="Delete" asp-route-id="@task.Id" method="post" onsubmit="return confirm('¿Eliminar esta tarea?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
