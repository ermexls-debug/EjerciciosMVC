@model MemoryGameViewModel

@{
    ViewData["Title"] = "Juego de memoria";
}

<style>
    .memory-board {
        display: grid;
        gap: 10px;
        max-width: 640px;
    }

    .memory-card {
        aspect-ratio: 1;
        font-size: 2.5rem;
        border-radius: 10px;
        border: 2px solid #0d6efd;
        background-color: #0d6efd;
        color: white;
        user-select: none;
    }

    .memory-card.flipped {
        background-color: white;
    }

    .memory-card.matched {
        background-color: #d1e7dd;
        border-color: #198754;
    }
</style>

<h1>Juego de memoria</h1>

<div class="mb-3">
    <span class="me-2">Nivel:</span>
    <a asp-action="Index" asp-route-level="Easy" class="btn btn-sm @(Model.Level == GameLevel.Easy ? "btn-primary" : "btn-outline-primary")">Fácil (6 parejas)</a>
    <a asp-action="Index" asp-route-level="Medium" class="btn btn-sm @(Model.Level == GameLevel.Medium ? "btn-primary" : "btn-outline-primary")">Medio (8 parejas)</a>
    <a asp-action="Index" asp-route-level="Hard" class="btn btn-sm @(Model.Level == GameLevel.Hard ? "btn-primary" : "btn-outline-primary")">Difícil (12 parejas)</a>
</div>

<div class="d-flex gap-4 mb-3">
    <div>Nivel: <strong>@Model.LevelName</strong></div>
    <div>Movimientos: <strong id="moves">0</strong></div>
    <div>Tiempo: <strong id="time">0</strong> s</div>
    <div>Parejas: <strong id="pairs">0</strong> de @Model.PairCount</div>
</div>

<div id="board" class="memory-board mb-4" style="grid-template-columns: repeat(@Model.Columns, 1fr);" data-pairs="@Model.PairCount" data-level="@((int)Model.Level)">
    @foreach (string card in Model.Cards)
    {
        <button type="button" class="memory-card" data-symbol="@card">?</button>
    }
</div>

<div id="winPanel" class="alert alert-success" style="display: none; max-width: 640px;">
    <h4>¡Ganaste!</h4>
    <p class="mb-2">Lo lograste en <strong id="winMoves"></strong> movimientos y <strong id="winTime"></strong> segundos.</p>
    <p class="mb-3">Puntaje: <strong id="winPoints"></strong></p>
    <a asp-action="Index" asp-route-level="@Model.Level" class="btn btn-success">Jugar otra vez</a>
</div>

@section Scripts {
    <script src="~/js/memory-game.js" asp-append-version="true"></script>
}
