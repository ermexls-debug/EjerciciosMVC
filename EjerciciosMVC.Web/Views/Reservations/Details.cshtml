@model Reservation

@{
    ViewData["Title"] = "Reserva";
}

<h1>Reserva #@Model.Id</h1>

<partial name="_Messages" />

<div class="row">
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-body">
                <p><partial name="_StatusBadge" model="Model.Status" /></p>
                <p class="mb-1"><strong>Cliente:</strong> @Model.CustomerName</p>
                <p class="mb-1"><strong>Teléfono:</strong> @Model.CustomerPhone</p>
                <p class="mb-1"><strong>Servicio:</strong> @Model.Service?.Name</p>
                <p class="mb-1"><strong>Fecha:</strong> @Model.StartAt.ToString("dd/MM/yyyy")</p>
                <p class="mb-0"><strong>Hora:</strong> @Model.StartAt.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture) a @Model.EndAt.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)</p>
            </div>
        </div>

        <div class="d-flex gap-2 mb-3">
            @if (Model.Status == ReservationStatus.Pending)
            {
                <form asp-action="Confirm" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-success">Confirmar reserva</button>
                </form>
            }

            @if (Model.Status != ReservationStatus.Cancelled)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('¿Cancelar esta reserva?');">
                    <button type="submit" class="btn btn-outline-danger">Cancelar reserva</button>
                </form>
            }
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Hacer otra reserva</a>
        <a asp-action="List" class="btn btn-outline-secondary">Ver todas las reservas</a>
    </div>
</div>
