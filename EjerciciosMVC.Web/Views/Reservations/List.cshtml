@model List<Reservation>

@{
    ViewData["Title"] = "Próximas reservas";
}

<h1>Próximas reservas</h1>

<div class="mb-3">
    <a asp-action="Index" class="btn btn-primary">Nueva reserva</a>
</div>

@if (Model.Count == 0)
{
    <p class="text-muted">No hay reservas próximas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Fecha</th>
                <th>Hora</th>
                <th>Servicio</th>
                <th>Cliente</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Reservation reservation in Model)
            {
                <tr>
                    <td>@reservation.Id</td>
                    <td>@reservation.StartAt.ToString("dd/MM/yyyy")</td>
                    <td>@reservation.StartAt.ToString("hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)</td>
                    <td>@reservation.Service?.Name</td>
                    <td>@reservation.CustomerName</td>
                    <td><partial name="_StatusBadge" model="reservation.Status" /></td>
                    <td><a asp-action="Details" asp-route-id="@reservation.Id" class="btn btn-sm btn-outline-primary">Ver</a></td>
                </tr>
            }
        </tbody>
    </table>
}
