@model ExpenseListViewModel

@{
    ViewData["Title"] = "Gastos";
}

<h1>Gastos de @Model.MonthName</h1>

<partial name="_Messages" />

<div class="d-flex justify-content-between mb-3">
    <div>
        <a asp-action="Index" asp-route-year="@Model.PreviousMonth.Year" asp-route-month="@Model.PreviousMonth.Month" class="btn btn-outline-secondary">&larr; Mes anterior</a>
        <a asp-action="Index" asp-route-year="@Model.NextMonth.Year" asp-route-month="@Model.NextMonth.Month" class="btn btn-outline-secondary">Mes siguiente &rarr;</a>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary">Registrar gasto</a>
    </div>
</div>

@if (Model.Expenses.Count == 0)
{
    <p class="text-muted">No hay gastos registrados en este mes.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Descripción</th>
                <th>Categoría</th>
                <th class="text-end">Valor</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Expense expense in Model.Expenses)
            {
                <tr>
                    <td>@expense.Date.ToString("dd/MM/yyyy")</td>
                    <td>@expense.Description</td>
                    <td>@expense.Category?.Name</td>
                    <td class="text-end">$@expense.Amount.ToString("N0")</td>
                    <td class="text-end">
                        <form asp-action="Delete" asp-route-id="@expense.Id" method="post" onsubmit="return confirm('¿Eliminar este gasto?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3">Total del mes</th>
                <th class="text-end">$@Model.Total.ToString("N0")</th>
                <th></th>
            </tr>
        </tfoot>
    </table>
}
